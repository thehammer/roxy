# Slack — from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...              # requires connections:write + app_configurations:write scopes
SLACK_APP_ID=A...                     # Settings > Basic Information > App ID
SLACK_CONFIG_REFRESH_TOKEN=xoxe-1-... # from https://api.slack.com/tools/config-tokens (for apply_manifest.py)

# AWS
AWS_REGION=us-east-1
ROXY_DYNAMODB_TABLE=roxy-channels
ROXY_REACTORS_TABLE=roxy-reactors

# Bot behaviour
INACTIVITY_PRUNE_DAYS=30
LOG_LEVEL=INFO
